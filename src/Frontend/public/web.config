<?xml version="1.0" encoding="utf-8"?>
<!-- Configuracion de IIS para la app Angular publicada en /appAmmiOnline/.
     Conserva lo que ya tenia el servidor (MIME, cabeceras, documento de inicio)
     y anade la reescritura de rutas de Angular a index.html. Requiere el modulo URL Rewrite. -->
<configuration>
  <system.webServer>

    <!-- MIME Types adicionales -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- Cabeceras de seguridad (remove primero para evitar duplicados con config heredada) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Documento de inicio -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Rutas de Angular: lo que no sea un archivo, una carpeta ni una ruta con extension va a index.html -->
    <rewrite>
      <rules>
        <rule name="Angular rutas" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="\.[A-Za-z0-9]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/appAmmiOnline/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
