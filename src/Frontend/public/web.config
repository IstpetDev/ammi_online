<?xml version="1.0" encoding="utf-8"?>
<!-- Configuracion de IIS para la aplicacion Angular en /appAmmiOnline/.
     Conserva los tipos MIME y cabeceras configurados en el servidor y anade
     la regla de URL Rewrite para servir index.html en rutas SPA sin tocar /apiAmmiOnline. -->
<configuration>
  <system.webServer>

    <!-- MIME Types adicionales -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- Cabeceras de seguridad (remove primero para evitar duplicados con config heredada) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Documento de inicio -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
