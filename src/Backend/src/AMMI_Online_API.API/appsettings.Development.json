{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "AMMI_Online_API": "Debug"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost",
      "https://localhost"
    ]
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "AuthPolicy": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    },
    "OtpPolicy": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    },
    "CatalogPolicy": {
      "PermitLimit": 300,
      "WindowMinutes": 1
    }
  },
  "AuthSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15,
    "FailedAttemptWindowMinutes": 15,
    "MaxActionAttempts": 10,
    "ActionWindowMinutes": 15
  },
  "EmailSettings": {
    "Host": "",
    "Port": 0,
    "FromEmail": "",
    "Password": "",
    "SenderName": "",
    "AdminEmail": "",
    "EnableSsl": false
  },
  "FrontendSettings": {
    "BaseUrl": "http://localhost:4200"
  }
}
