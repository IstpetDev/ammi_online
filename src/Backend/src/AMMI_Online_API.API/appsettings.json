{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "AMMI_Online_API": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedHosts": "ammionline.ammi.edu.ec;localhost",
  "Cors": {
    "AllowedOrigins": [
      "https://ammionline.ammi.edu.ec"
    ]
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "AMMI_Online_API",
    "Audience": "AMMI_Online_FrontEnd",
    "ExpirationMinutes": 60
  },
  "FileSettings": {
    "MaxFileSize": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".doc",
      ".docx"
    ],
    "UploadPath": "Uploads",
    "MaxFilesPerRequest": 10,
    "EnableVirusScan": false
  },
  "StorageSettings": {
    "Type": "Local",
    "Local": {
      "BasePath": "Uploads",
      "CreateDirectories": true
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "uploads"
    },
    "AWSS3": {
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "",
      "Region": "us-east-1"
    }
  },
  "SecuritySettings": {
    "MaxRequestSize": 52428800,
    "EnableFileTypeValidation": true,
    "BlockExecutableFiles": true,
    "AllowedMimeTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/gif",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    ]
  },
  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "FromEmail": "",
    "Password": "",
    "SenderName": "AMMI Online",
    "AdminEmail": "",
    "EnableSsl": true
  },
  "FrontendSettings": {
    "BaseUrl": "https://localhost:4200"
  }
}
